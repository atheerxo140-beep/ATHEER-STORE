# =====================================================================
# ATHEER STORE | أثير — Environment Configuration Template
# Project ID: zdkpxfxvazwwzemimykc
# Target Supabase Instance: https://zdkpxfxvazwwzemimykc.supabase.co
# =====================================================================
#
# INSTRUCTIONS:
# 1. Copy this file to '.env.local' in the project root:
#    cp .env.example .env.local
# 2. Retrieve your project API keys from:
#    https://supabase.com/dashboard/project/zdkpxfxvazwwzemimykc/settings/api
# 3. Paste the actual keys into the placeholders below.
# 4. NEVER commit '.env.local' to source control.
#
# =====================================================================

# ---------------------------------------------------------------------
# 1. SUPABASE PROJECT URL (Required - Public)
# ---------------------------------------------------------------------
# The unique endpoint for your Supabase project.
NEXT_PUBLIC_SUPABASE_URL=https://zdkpxfxvazwwzemimykc.supabase.co

# ---------------------------------------------------------------------
# 2. MODERN SUPABASE PUBLISHABLE KEY (Required - Public / Browser Safe)
# ---------------------------------------------------------------------
# Found in: Supabase Dashboard -> Settings -> API -> Project API Keys
# In modern Supabase, this is the Publishable API key (starts with "sbp_..." or standard JWT).
# This key is safe to be exposed in browser client-side bundles.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key-here

# Legacy Anon Key fallback (optional, if using traditional JWT anon key):
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# ---------------------------------------------------------------------
# 3. MODERN SUPABASE SECRET KEY (Required - Server-Side ONLY)
# ---------------------------------------------------------------------
# Found in: Supabase Dashboard -> Settings -> API -> Project API Keys
# In modern Supabase, this is the Secret Key (starts with "sb_sk_..." or service_role JWT).
#
# ⚠️ CRITICAL SECURITY WARNING ⚠️:
# - NEVER prefix this key with "NEXT_PUBLIC_".
# - NEVER import or reference this key in client-side components.
# - Used strictly inside Next.js server-side Route Handlers to insert orders,
#   manage inventory, and verify admin roles without exposing credentials.
SUPABASE_SECRET_KEY=your-supabase-secret-key-here

# Legacy Service Role Key fallback (optional, if using traditional service_role JWT):
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# ---------------------------------------------------------------------
# 4. STORE OPERATIONAL CONFIGURATION (Egypt Market - EGP)
# ---------------------------------------------------------------------
# Default checkout currency (strictly Egyptian Pound)
NEXT_PUBLIC_DEFAULT_CURRENCY=EGP

# Official Concierge WhatsApp Phone Number (Egyptian international format: 201xxxxxxxxx)
# Example: 201012345678 (Leave unconfigured if pending SIM card registration)
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Public Storefront URL (defaults to localhost:3000 in local dev)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
