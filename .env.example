# =====================================================================
# ATHEER STORE | أثير — Environment Variables
# Copy this file to .env.local and populate with your Supabase project keys
# =====================================================================

# 1. Supabase Project URL (From Supabase Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# 2. Supabase Anon Public Key (Safe for client-side data queries)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# 3. Supabase Service Role Key (Server-side ONLY - NEVER exposed to browser)
# Used exclusively inside Next.js Route Handlers to insert orders & update inventory
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# 4. Storefront Base URL (Optional, defaults to localhost:3000)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
